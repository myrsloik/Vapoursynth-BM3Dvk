 *
 * GLSL port of shader.metal for the VapourSynth Vulkan GPU API. One source serves all
 * eight variants: TEMPORAL/CHROMA/FINAL are specialization constants and every branch on
 * them folds at pipeline creation. Licensed GPL-3.0-or-later like the original.
 *
 * Layout contract with the host (identical to the Metal packed layout):
 *   binding 0 res: uint-typed accumulator. Non-chroma temporal binds the tall output
 *     plane itself; everything else binds scratch. Per packed plane: T slots of
 *     [wdst H rows][weight H rows], each row `stride` elements.
 *   binding 1 src: packed source stack. Per clip (ref first when FINAL), per packed
 *     plane, per temporal tap: H rows of `stride` elements.
 * All float accumulation goes through CAS on the uint view, exactly as the Metal
 * original emulates float atomics.
 */
#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require

/* One workgroup is gl_WorkGroupSize.x / 8 independent 8-lane clusters, each denoising one
   block position; 32 on wave32 hardware, 64 on wave64, chosen by the host to match the
   subgroup so the width-8 shuffles stay inside one wave. */
layout(local_size_x = 32, local_size_x_id = 3, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const bool TEMPORAL = false;
layout(constant_id = 1) const bool CHROMA = false;
layout(constant_id = 2) const bool FINAL = false;

layout(std430, binding = 0) buffer Res { uint res[]; };
layout(std430, binding = 1) readonly buffer Src { float src[]; };

layout(push_constant) uniform PC {
    int width;
    int height;
    int stride;
    float sigma;
    int block_step;
    int bm_range;
    int radius;
    int ps_num;
    int ps_range;
    float sigma_u;
    float sigma_v;
    float extractor;
} pc;

/* Sized by the workgroup width, a specialization expression that folds at pipeline
   creation, so a 32-wide pipeline allocates no LDS for lanes it does not have. */
#define smem_stride (int(gl_WorkGroupSize.x) + 1)
shared float smem[8 * (gl_WorkGroupSize.x + 1u)];

/* All shuffles in this kernel work in width-8 partitions of the 32-lane subgroup, as the
   Metal original's explicit width argument did. Xor with a mask below 8 never crosses an
   8-lane boundary, up-shifts are guarded, and the broadcast computes the absolute lane. */
float shfl_xor8(float v, uint m) { return subgroupShuffleXor(v, m); }

float shfl_up8f(float v, uint d) {
    float r = subgroupShuffleUp(v, d);
    return (gl_SubgroupInvocationID % 8u) < d ? v : r;
}
int shfl_up8i(int v, uint d) {
    int r = subgroupShuffleUp(v, d);
    return (gl_SubgroupInvocationID % 8u) < d ? v : r;
}
bool shfl_up8b(bool v, uint d) {
    int r = subgroupShuffleUp(v ? 1 : 0, d);
    return (gl_SubgroupInvocationID % 8u) < d ? v : (r != 0);
}
float shfl8f(float v, int lane) { return subgroupShuffle(v, (gl_SubgroupInvocationID & ~7u) + uint(lane)); }
int shfl8i(int v, int lane) { return subgroupShuffle(v, (gl_SubgroupInvocationID & ~7u) + uint(lane)); }

/* Float add emulated with compare-exchange on the uint view, as the original does; core
   Vulkan has no float atomics and the required feature set adds no extensions. */
void atomic_add_float(uint idx, float val) {
    uint expected = res[idx];
    for (;;) {
        uint desired = floatBitsToUint(uintBitsToFloat(expected) + val);
        uint prev = atomicCompSwap(res[idx], expected, desired);
        if (prev == expected)
            break;
        expected = prev;
    }
}

/* FFTW-generated 8 point DCT pair, transcribed token for token. */
void dct_fwd(inout float v[8]) {
    const float KP414213562 = 0.414213562373095048801688724209698078569671875;
    const float KP1_847759065 = 1.847759065022573512256366378793576573644833252;
    const float KP198912367 = 0.198912367379658006911597622644676228597850501;
    const float KP1_961570560 = 1.961570560806460898252364472268478073947867462;
    const float KP1_414213562 = 1.414213562373095048801688724209698078569671875;
    const float KP668178637 = 0.668178637919298919997757686523080761552472251;
    const float KP1_662939224 = 1.662939224605090474157576755235811513477121624;
    const float KP707106781 = 0.707106781186547524400844362104849039284835938;

    float T1 = v[0];
    float T2 = v[7];
    float T3 = T1 - T2;
    float Tj = T1 + T2;
    float Tc = v[4];
    float Td = v[3];
    float Te = Tc - Td;
    float Tk = Tc + Td;
    float T4 = v[2];
    float T5 = v[5];
    float T6 = T4 - T5;
    float T7 = v[1];
    float T8 = v[6];
    float T9 = T7 - T8;
    float Ta = T6 + T9;
    float Tn = T7 + T8;
    float Tf = T6 - T9;
    float Tm = T4 + T5;
    float Tb = fma(-KP707106781, Ta, T3);
    float Tg = fma(-KP707106781, Tf, Te);
    v[3] = KP1_662939224 * (fma(KP668178637, Tg, Tb));
    v[5] = -(KP1_662939224 * (fma(-KP668178637, Tb, Tg)));
    float Tp = Tj + Tk;
    float Tq = Tm + Tn;
    v[4] = KP1_414213562 * (Tp - Tq);
    v[0] = KP1_414213562 * (Tp + Tq);
    float Th = fma(KP707106781, Ta, T3);
    float Ti = fma(KP707106781, Tf, Te);
    v[1] = KP1_961570560 * (fma(-KP198912367, Ti, Th));
    v[7] = KP1_961570560 * (fma(KP198912367, Th, Ti));
    float Tl = Tj - Tk;
    float To = Tm - Tn;
    v[2] = KP1_847759065 * (fma(-KP414213562, To, Tl));
    v[6] = KP1_847759065 * (fma(KP414213562, Tl, To));
}

void dct_inv(inout float v[8]) {
    const float KP1_662939224 = 1.662939224605090474157576755235811513477121624;
    const float KP668178637 = 0.668178637919298919997757686523080761552472251;
    const float KP1_961570560 = 1.961570560806460898252364472268478073947867462;
    const float KP198912367 = 0.198912367379658006911597622644676228597850501;
    const float KP1_847759065 = 1.847759065022573512256366378793576573644833252;
    const float KP707106781 = 0.707106781186547524400844362104849039284835938;
    const float KP414213562 = 0.414213562373095048801688724209698078569671875;
    const float KP1_414213562 = 1.414213562373095048801688724209698078569671875;

    float T1 = v[0] * KP1_414213562;
    float T2 = v[4];
    float T3 = fma(KP1_414213562, T2, T1);
    float Tj = fma(-KP1_414213562, T2, T1);
    float T4 = v[2];
    float T5 = v[6];
    float T6 = fma(KP414213562, T5, T4);
    float Tk = fma(KP414213562, T4, -T5);
    float T8 = v[1];
    float Td = v[7];
    float T9 = v[5];
    float Ta = v[3];
    float Tb = T9 + Ta;
    float Te = Ta - T9;
    float Tc = fma(KP707106781, Tb, T8);
    float Tn = fma(-KP707106781, Te, Td);
    float Tf = fma(KP707106781, Te, Td);
    float Tm = fma(-KP707106781, Tb, T8);
    float T7 = fma(KP1_847759065, T6, T3);
    float Tg = fma(KP198912367, Tf, Tc);
    v[7] = fma(-KP1_961570560, Tg, T7);
    v[0] = fma(KP1_961570560, Tg, T7);
    float Tp = fma(-KP1_847759065, Tk, Tj);
    float Tq = fma(KP668178637, Tm, Tn);
    v[5] = fma(-KP1_662939224, Tq, Tp);
    v[2] = fma(KP1_662939224, Tq, Tp);
    float Th = fma(-KP1_847759065, T6, T3);
    float Ti = fma(-KP198912367, Tc, Tf);
    v[3] = fma(-KP1_961570560, Ti, Th);
    v[4] = fma(KP1_961570560, Ti, Th);
    float Tl = fma(KP1_847759065, Tk, Tj);
    float To = fma(-KP668178637, Tn, Tm);
    v[6] = fma(-KP1_662939224, To, Tl);
    v[1] = fma(KP1_662939224, To, Tl);
}

/* The transform/transpose walks from the Metal template instantiations, as macros over a
   named 64 element array so no array is ever passed by value.
     TRANSFORM_S1: <stride=1, howmany=8, howmany_stride=8> — DCT along one spatial axis
     TRANSFORM_S8: <stride=8, howmany=8, howmany_stride=1> — DCT along the patch axis
     TRANSPOSE8:   the smem 8x8 transpose per patch */
#define TRANSFORM_S1(arr, DCTFN) { \
    for (int iter_ = 0; iter_ < 8; ++iter_) { \
        int base_ = iter_ * 8; \
        float v_[8]; \
        for (int i_ = 0; i_ < 8; ++i_) v_[i_] = arr[base_ + i_]; \
        DCTFN(v_); \
        for (int i_ = 0; i_ < 8; ++i_) arr[base_ + i_] = v_[i_]; \
    } }

#define TRANSFORM_S8(arr, DCTFN) { \
    for (int iter_ = 0; iter_ < 8; ++iter_) { \
        float v_[8]; \
        for (int i_ = 0; i_ < 8; ++i_) v_[i_] = arr[iter_ + i_ * 8]; \
        DCTFN(v_); \
        for (int i_ = 0; i_ < 8; ++i_) arr[iter_ + i_ * 8] = v_[i_]; \
    } }

#define TRANSPOSE8(arr) { \
    uint tid_ = gl_SubgroupInvocationID; \
    for (int iter_ = 0; iter_ < 8; ++iter_) { \
        int base_ = iter_ * 8; \
        barrier(); \
        for (int i_ = 0; i_ < 8; ++i_) smem[i_ * smem_stride + int(tid_)] = arr[base_ + i_]; \
        barrier(); \
        for (int i_ = 0; i_ < 8; ++i_) \
            arr[base_ + i_] = smem[int(tid_ % 8u) * smem_stride + int(tid_ & ~7u) + i_]; \
    } }

/* Hard thresholding over the 3D spectrum; writes the shrunk coefficients back scaled by
   1/4096 (the unnormalised DCT chain's total gain) and returns 1/(retained count). */
#define HARD_THRESHOLD(arr, sigma_, outWeight) { \
    const float inv_norm_ = 1.0 / 4096.0; \
    float ks_[4] = float[4](0.0, 0.0, 0.0, 0.0); \
    for (int i_ = 0; i_ < 64; ++i_) { \
        float val_ = arr[i_]; \
        float thr_ = (i_ == 0) ? (((gl_SubgroupInvocationID % 8u) != 0u) ? sigma_ : 0.0) : sigma_; \
        float flag_ = (abs(val_) >= thr_) ? 1.0 : 0.0; \
        ks_[i_ % 4] += flag_; \
        arr[i_] = (flag_ != 0.0) ? (val_ * inv_norm_) : 0.0; \
    } \
    float k_ = (ks_[0] + ks_[1]) + (ks_[2] + ks_[3]); \
    for (int i_ = 4; i_ >= 1; i_ /= 2) \
        k_ += shfl_xor8(k_, uint(i_)); \
    outWeight = 1.0 / k_; }

/* Empirical Wiener shrinkage against the reference spectrum; same normalisation and
   weight convention. */
#define WIENER_FILTER(arr, refArr, sigma_, outWeight) { \
    const float inv_norm_ = 1.0 / 4096.0; \
    float ks_[4] = float[4](0.0, 0.0, 0.0, 0.0); \
    float sigma_sq_ = sigma_ * sigma_; \
    for (int i_ = 0; i_ < 64; ++i_) { \
        float val_ = arr[i_]; \
        float ref_val_ = refArr[i_]; \
        float ref_sq_ = ref_val_ * ref_val_; \
        float coeff_ = ref_sq_ / (ref_sq_ + sigma_sq_); \
        if (i_ == 0 && (gl_SubgroupInvocationID % 8u) == 0u) \
            coeff_ = 1.0; \
        val_ *= coeff_; \
        ks_[i_ % 4] += coeff_ * coeff_; \
        arr[i_] = val_ * inv_norm_; \
    } \
    float k_ = (ks_[0] + ks_[1]) + (ks_[2] + ks_[3]); \
    for (int i_ = 4; i_ >= 1; i_ /= 2) \
        k_ += shfl_xor8(k_, uint(i_)); \
    outWeight = 1.0 / k_; }

/* Forward 3D transform, shrink, inverse 3D transform. */
#define COLLABORATIVE_HARD(arr, sigma_, outWeight) { \
    for (int nd_ = 0; nd_ < 2; ++nd_) { TRANSFORM_S1(arr, dct_fwd) TRANSPOSE8(arr) } \
    TRANSFORM_S8(arr, dct_fwd) \
    HARD_THRESHOLD(arr, sigma_, outWeight) \
    for (int nd_ = 0; nd_ < 2; ++nd_) { TRANSFORM_S1(arr, dct_inv) TRANSPOSE8(arr) } \
    TRANSFORM_S8(arr, dct_inv) }

#define COLLABORATIVE_WIENER(arr, refArr, sigma_, outWeight) { \
    for (int nd_ = 0; nd_ < 2; ++nd_) { TRANSFORM_S1(arr, dct_fwd) TRANSPOSE8(arr) } \
    TRANSFORM_S8(arr, dct_fwd) \
    for (int nd_ = 0; nd_ < 2; ++nd_) { TRANSFORM_S1(refArr, dct_fwd) TRANSPOSE8(refArr) } \
    TRANSFORM_S8(refArr, dct_fwd) \
    WIENER_FILTER(arr, refArr, sigma_, outWeight) \
    for (int nd_ = 0; nd_ < 2; ++nd_) { TRANSFORM_S1(arr, dct_inv) TRANSPOSE8(arr) } \
    TRANSFORM_S8(arr, dct_inv) }

void main() {
    float sigma = pc.sigma;
    uint tid = gl_SubgroupInvocationID;
    int sub_lane_id = int(tid % 8u);
    int clusters = int(gl_WorkGroupSize.x) / 8;
    int x = (clusters * int(gl_WorkGroupID.x) + int(tid / 8u)) * pc.block_step;
    int y = pc.block_step * int(gl_WorkGroupID.y);

    /* The Metal original returns here for fully out of range clusters. A return would make
       the barriers inside the transposes non-uniform, which Vulkan forbids, so out of range
       clusters run the whole kernel on the clamped (duplicate) block and only their
       aggregation stores are suppressed. */
    bool liveBlock = !(x >= pc.width - 8 + pc.block_step || y >= pc.height - 8 + pc.block_step);

    x = min(x, pc.width - 8);
    y = min(y, pc.height - 8);

    int radius = TEMPORAL ? pc.radius : 0;

    int temporal_stride = pc.height * pc.stride;
    int temporal_width = 2 * radius + 1;
    int plane_stride = temporal_width * temporal_stride;
    int clip_stride = (CHROMA ? 3 : 1) * temporal_width * temporal_stride;

    float current_patch[8];
    int srcpcBase = radius * temporal_stride + sub_lane_id;

    {
        int srcp = srcpcBase + y * pc.stride + x;
        for (int i = 0; i < 8; ++i)
            current_patch[i] = src[srcp + i * pc.stride];
    }

    const float initial_error = 3.402823466e+38;
    float errors8 = initial_error;
    int index8_x = 0;
    int index8_y = 0;

    /* Spatial block matching: exhaustive SSD over the window, maintaining the 8 best in
       ascending order across the cluster's lanes by shift-insertion. */
    {
        int left = max(x - pc.bm_range, 0);
        int right = min(x + pc.bm_range, pc.width - 8);
        int top = max(y - pc.bm_range, 0);
        int bottom = min(y + pc.bm_range, pc.height - 8);

        int srcp_row = srcpcBase + top * pc.stride + left;
        for (int row_i = top; row_i <= bottom; ++row_i) {
            int srcp_col = srcp_row;
            for (int col_i = left; col_i <= right; ++col_i) {
                float errors0 = 0.0;
                float errors1 = 0.0;
                int srcp = srcp_col;


                for (int i = 0; i < 8; ++i) {
                    float val = current_patch[i] - src[srcp + i * pc.stride];
                    if ((i % 2) == 0)
                        errors0 += val * val;
                    else
                        errors1 += val * val;
                }

                float error = errors0 + errors1;

                for (int i = 4; i >= 1; i /= 2)
                    error += shfl_xor8(error, uint(i));

                float pre_error = shfl_up8f(errors8, 1u);
                int pre_index_x = shfl_up8i(index8_x, 1u);
                int pre_index_y = shfl_up8i(index8_y, 1u);

                bool flag = error < errors8;
                bool pre_flag = shfl_up8b(flag, 1u);

                if (flag) {
                    bool first = (sub_lane_id == 0) || (!pre_flag);
                    errors8 = first ? error : pre_error;
                    index8_x = first ? col_i : pre_index_x;
                    index8_y = first ? row_i : pre_index_y;
                }
                ++srcp_col;
            }
            srcp_row += pc.stride;
        }
    }
    int index8_z = radius;

    /* Temporal predictive search: seed each neighbouring frame's window from the previous
       frame's best ps_num matches, then merge that frame's best into the global list. */
    if (TEMPORAL) {
        int center_index8_x = index8_x;
        int center_index8_y = index8_y;

        for (int direction = -1; direction <= 1; direction += 2) {
            int last_index8_x = center_index8_x;
            int last_index8_y = center_index8_y;

            for (int t = 1; t <= radius; ++t) {
                int temporal_index = radius + direction * t;
                float frame_errors8 = initial_error;
                int frame_index8_x = 0;
                int frame_index8_y = 0;

                int temporal_srcpc = temporal_index * temporal_stride + sub_lane_id;

                for (int i = 0; i < pc.ps_num; ++i) {
                    int xx = shfl8i(last_index8_x, i);
                    int yy = shfl8i(last_index8_y, i);

                    int left = max(xx - pc.ps_range, 0);
                    int right = min(xx + pc.ps_range, pc.width - 8);
                    int top = max(yy - pc.ps_range, 0);
                    int bottom = min(yy + pc.ps_range, pc.height - 8);

                    int srcp_row = temporal_srcpc + top * pc.stride + left;
                    for (int row_i = top; row_i <= bottom; ++row_i) {
                        int srcp_col = srcp_row;
                        for (int col_i = left; col_i <= right; ++col_i) {
                            float errors0 = 0.0;
                            float errors1 = 0.0;
                            int srcp = srcp_col;


                            for (int j = 0; j < 8; ++j) {
                                float val = current_patch[j] - src[srcp + j * pc.stride];
                                if ((j % 2) == 0)
                                    errors0 += val * val;
                                else
                                    errors1 += val * val;
                            }

                            float error = errors0 + errors1;

                            for (int k = 4; k >= 1; k /= 2)
                                error += shfl_xor8(error, uint(k));

                            float pre_error = shfl_up8f(frame_errors8, 1u);
                            int pre_index_x = shfl_up8i(frame_index8_x, 1u);
                            int pre_index_y = shfl_up8i(frame_index8_y, 1u);

                            bool flag = error < frame_errors8;
                            bool pre_flag = shfl_up8b(flag, 1u);

                            if (flag) {
                                bool first = (sub_lane_id == 0) || (!pre_flag);
                                frame_errors8 = first ? error : pre_error;
                                frame_index8_x = first ? col_i : pre_index_x;
                                frame_index8_y = first ? row_i : pre_index_y;
                            }
                            ++srcp_col;
                        }
                        srcp_row += pc.stride;
                    }
                }

                for (int i = 0; i < pc.ps_num; ++i) {
                    float tmp_error = shfl8f(frame_errors8, i);
                    int tmp_x = shfl8i(frame_index8_x, i);
                    int tmp_y = shfl8i(frame_index8_y, i);

                    bool flag = tmp_error < errors8;
                    bool pre_flag = shfl_up8b(flag, 1u);
                    float pre_error = shfl_up8f(errors8, 1u);
                    int pre_index_x = shfl_up8i(index8_x, 1u);
                    int pre_index_y = shfl_up8i(index8_y, 1u);
                    int pre_index_z = shfl_up8i(index8_z, 1u);

                    if (flag) {
                        bool first = (sub_lane_id == 0) || (!pre_flag);
                        errors8 = first ? tmp_error : pre_error;
                        index8_x = first ? tmp_x : pre_index_x;
                        index8_y = first ? tmp_y : pre_index_y;
                        index8_z = first ? temporal_index : pre_index_z;
                    }
                }
                last_index8_x = frame_index8_x;
                last_index8_y = frame_index8_y;
            }
        }
    }

    /* The reference block must be in its own group: if matching lost it, insert it at the
       front with error 0. The condition is cluster-uniform, so the shuffles inside stay
       converged. */
    {
        int flag_val;
        if (TEMPORAL)
            flag_val = (index8_x == x && index8_y == y && index8_z == radius) ? 1 : 0;
        else
            flag_val = (index8_x == x && index8_y == y) ? 1 : 0;
        float flag = float(flag_val);

        for (int i = 4; i >= 1; i /= 2)
            flag += shfl_xor8(flag, uint(i));

        float pre_error = shfl_up8f(errors8, 1u);
        int pre_index_x = shfl_up8i(index8_x, 1u);
        int pre_index_y = shfl_up8i(index8_y, 1u);
        if (flag == 0.0) {
            bool first = (sub_lane_id == 0);
            errors8 = first ? 0.0 : pre_error;
            index8_x = first ? x : pre_index_x;
            index8_y = first ? y : pre_index_y;
            if (TEMPORAL) {
                int pre_index_z = shfl_up8i(index8_z, 1u);
                index8_z = first ? radius : pre_index_z;
            }
        }
    }

    float denoising_patch[64];
    float ref_patch[64];

    int srcPlaneBase = 0;
    int resPlaneBase = 0;

    int num_planes = CHROMA ? 3 : 1;
    for (int plane = 0; plane < num_planes; ++plane) {
        if (plane == 1)
            sigma = pc.sigma_u;
        else if (plane == 2)
            sigma = pc.sigma_v;

        if (CHROMA) {
            const float epsilon = 1.19209290e-07;
            if (sigma < epsilon) {
                srcPlaneBase += plane_stride;
                resPlaneBase += plane_stride * 2;
                continue;
            }
        }

        float adaptive_weight;
        if (FINAL) {
            for (int i = 0; i < 8; ++i) {
                int tmp_x = shfl8i(index8_x, i);
                int tmp_y = shfl8i(index8_y, i);
                int refp;
                if (TEMPORAL) {
                    int tmp_z = shfl8i(index8_z, i);
                    refp = srcPlaneBase + tmp_z * temporal_stride + tmp_y * pc.stride + tmp_x + sub_lane_id;
                } else {
                    refp = srcPlaneBase + tmp_y * pc.stride + tmp_x + sub_lane_id;
                }
                int srcp = refp + clip_stride;

                for (int j = 0; j < 8; ++j) {
                    ref_patch[i * 8 + j] = src[refp + j * pc.stride];
                    denoising_patch[i * 8 + j] = src[srcp + j * pc.stride];
                }
            }
            COLLABORATIVE_WIENER(denoising_patch, ref_patch, sigma, adaptive_weight)
        } else {
            for (int i = 0; i < 8; ++i) {
                int tmp_x = shfl8i(index8_x, i);
                int tmp_y = shfl8i(index8_y, i);
                int srcp;
                if (TEMPORAL) {
                    int tmp_z = shfl8i(index8_z, i);
                    srcp = srcPlaneBase + tmp_z * temporal_stride + tmp_y * pc.stride + tmp_x + sub_lane_id;
                } else {
                    srcp = srcPlaneBase + tmp_y * pc.stride + tmp_x + sub_lane_id;
                }

                for (int j = 0; j < 8; ++j)
                    denoising_patch[i * 8 + j] = src[srcp + j * pc.stride];
            }
            COLLABORATIVE_HARD(denoising_patch, sigma, adaptive_weight)
        }

        int wdstpcBase = resPlaneBase + sub_lane_id;
        int weightpcBase = resPlaneBase + temporal_stride + sub_lane_id;

        for (int i = 0; i < 8; ++i) {
            int tmp_x = shfl8i(index8_x, i);
            int tmp_y = shfl8i(index8_y, i);
            int off;
            if (TEMPORAL) {
                int tmp_z = shfl8i(index8_z, i);
                off = tmp_z * 2 * temporal_stride + tmp_y * pc.stride + tmp_x;
            } else {
                off = tmp_y * pc.stride + tmp_x;
            }

            if (liveBlock) {
                for (int j = 0; j < 8; ++j) {
                    /* The extractor rounding makes the atomic accumulation order
                       independent; `precise` on the destination covers the whole add/sub
                       chain, or the compiler could legally fold (x + e) - e to x. */
                    precise float wdst_val =
                        (adaptive_weight * denoising_patch[i * 8 + j] + pc.extractor) - pc.extractor;
                    precise float weight_val = (adaptive_weight + pc.extractor) - pc.extractor;

                    atomic_add_float(uint(wdstpcBase + off + j * pc.stride), wdst_val);
                    atomic_add_float(uint(weightpcBase + off + j * pc.stride), weight_val);
                }
            }
        }

        srcPlaneBase += plane_stride;
        resPlaneBase += plane_stride * 2;
    }
}
